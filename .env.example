# --- API (src/api/main.py) ---
# Comma-separated frontend origins allowed to call the API. Set this to your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Folder holding models/ and processed/ (default: data)
ARTIFACTS_DIR=data
# Set to 1 to skip the real model and return clearly labelled demo scores
DEMO_MODE=0

# --- Frontend (web/config.js) ---
# A static site cannot read env vars, so edit window.API_URL in web/config.js instead.
# API_URL=http://localhost:8000

# --- Data scraping only (not needed to run the site) ---
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=street_photo_scorer/1.0
